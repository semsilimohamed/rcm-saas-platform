# Copy to backend/.env and fill in. Never commit the real .env.

# PostgreSQL connection string (Supabase pooler URL)
DATABASE_URL=

# JWT signing key — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Optional — JWT algorithm (default HS256); leave commented to use the default
# ALGORITHM=HS256

# Optional — access token lifetime in minutes (default 480)
# ACCESS_TOKEN_EXPIRE_MINUTES=480

# Comma-separated list of allowed frontend origins, e.g. http://localhost:3000
ALLOWED_ORIGINS=
